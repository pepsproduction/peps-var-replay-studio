{
  "project": "Peps VAR Replay Studio",
  "version": "2.0.0",
  "defaultMode": "control",
  "theme": {
    "primary": "#ff5a00",
    "secondary": "#ff8a36",
    "accent": "#34c8ff",
    "background": "#07090c"
  },
  "playback": {
    "speedMin": 0.25,
    "speedMax": 2.0,
    "zoomMin": 1.0,
    "zoomMax": 10.0
  },
  "obs": {
    "controlQuery": "?mode=control",
    "screenQuery": "?mode=screen",
    "highlightScreenQuery": "?mode=highlight-screen",
    "recommendedWidth": 1920,
    "recommendedHeight": 1080,
    "keepSourceActiveWhenHidden": true
  }
}
